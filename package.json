{
    "name": "OperationAnnotator",
    "displayName": "Разметчик операций",
    "publisher": "kapadmitrieva",
    "version": "1.0.0",
    "engines": {
        "vscode": "^1.136.1"
    },
    "categories": [
        "Other"
    ],
    "main": "./out/extension.js",
    "activationEvents": [],
    "contributes": {
        "commands": [
            {
                "command": "OperationAnnotator.annotateCode",
                "title": "Дополнить операции комментариями"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "OperationAnnotator.annotateCode",
                    "group": "modification"
                }
            ]
        }
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/vscode": "^1.145.0",
        "typescript": "^7.0.2"
    }
}
